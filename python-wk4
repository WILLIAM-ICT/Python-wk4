def read_and_write_file():
    # Step 1: Ask the user for a filename
    input_filename = input("Enter the filename to read from: ")

    try:
        # Step 2: Open the input file to read
        with open(input_filename, 'r') as file:
            content = file.read()
            print("File content successfully read!")

        # Step 3: Modify the content (e.g., adding a simple line)
        modified_content = content + "\nThis is the modified content added."

        # Step 4: Write the modified content to a new file
        output_filename = "modified_" + input_filename
        with open(output_filename, 'w') as output_file:
            output_file.write(modified_content)
            print(f"Modified content successfully written to {output_filename}")

    except FileNotFoundError:
        print(f"Error: The file '{input_filename}' does not exist.")
    except PermissionError:
        print(f"Error: You don't have permission to read or write to the file '{input_filename}'.")
    except Exception as e:
        print(f"An unexpected error occurred: {e}")


# Call the function to run the program
read_and_write_file()
